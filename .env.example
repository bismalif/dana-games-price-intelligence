# Copy to .env for local scraper runs. NEVER commit the real .env file.
# The Supabase SECRET key is server-side only (scraper / GitHub Actions).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Gemini fallback parser (used only when deterministic extraction fails)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# DingTalk group robot (signed webhook). Leave empty to disable alerting.
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
DINGTALK_SECRET=SECxxxxxxxxxxxxxxxx

# Optional tuning
ALERT_THRESHOLD=0.10
REQUEST_DELAY_SECONDS=3.0
